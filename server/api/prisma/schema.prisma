// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  password      String
  email         String         @unique
  words         Word[]
  refreshTokens RefreshToken[]
  Media         Media[]
  MediaWord     MediaWord[]
  settings      Settings?
  learnedWords  LearnedWord[]
  DailySession  DailySession[]
}

model Word {
  id          String   @id @default(cuid())
  word        String
  type        WordType
  description String
  extraNotes  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examples String
  synonyms String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learnedWords LearnedWord[]
  DailySession DailySession[]

  @@unique([word, userId])
  @@index([userId])
}

model LearnedWord {
  id        String   @id @default(cuid())
  learnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

model DailySession {
  id     String   @id @default(cuid())
  date   DateTime
  userId String
  wordId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId, date])
  @@index([userId, date])
}

enum WordType {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
}

enum AccentChoice {
  EN_US
  EN_GB
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revoked   Boolean   @default(false)
}

model Media {
  id    String  @id @default(cuid())
  title String
  image String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaWords MediaWord[]
  createdAt  DateTime    @default(now())
}

model MediaWord {
  id          String   @id @default(cuid())
  word        String
  type        WordType
  description String
  examples    String
  synonyms    String
  extraNotes  String?

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([word, mediaId, userId])
}

model Settings {
  id                         String       @id @default(cuid())
  dailyWordCount             Int
  accentChoice               AccentChoice @default(EN_US)
  userId                     String       @unique
  user                       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  showDailyLearningWordModal Boolean      @default(true)
}

model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String
  subject String
  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
}
